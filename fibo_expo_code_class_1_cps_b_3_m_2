#include<bits/stdc++.h>
using namespace std;

/// a ^ b   ber korbo recursion use kore
/**

   a ^ b --->  even hole   (a^ b/2) ^ 2

   a ^ b --->  odd hole   ( a ^ b -1 ) * 2

*/


int power(int a, int b){

 if(b == 0) return 1;

 if(b % 2 == 0){
     int x = power(a, b/2);
     return x * x;

 }
 else{
    return power(a, b - 1)* a;
 }


}


int main(){

     int a, b;
     cin >> a >> b ;

     cout << power(a,b);

return 0;
}





///  Coin change problem using Dinamic programming

5, 12, 23,............
 r o coin ace koto gula coin diye 122 tk banaice parbo



#include<bits/stdc++.h>
using namespace std;

/// complexity --> n ^ m

vector<int>coins = {5,12,23};

int isPossible(int n){

    if(n < 0) return 0;
    if(n == 0) return 1;


    for(int coin :coins){
        if(isPossible(n - coin)) return 1;
    }

     return 0;
}


int main(){

    int n;
    cin >> n;

    cout << isPossible(n) << '\n';


return 0;
}




#include<bits/stdc++.h>
using namespace std;

/// dp use korar por complexity

/// complexity --> O(n * m)

vector<int>coins = {5,12,23};
int dp[100005];
int isPossible(int n){

    if(n < 0) return 0;
    if(n == 0) return 1;

   ///dp state

   if(dp[n] != -1) return dp[n];
   int res = 0;

    for(int coin :coins){
        if(isPossible(n - coin)) res =  1;
    }

    return dp[n] = res;

     return 0;
}


int main(){

  memset(dp, -1, sizeof(dp));
    int n;
    cin >> n;

    cout << isPossible(n) << '\n';


return 0;
}

