/// final solve --> 


#include<bits/stdc++.h>
using namespace std;

#define mod 1000000007

/// 2ta arrray use kore memoization code

int n, vis[1000005], dp[1000005];


int solve(int sum){

  /// handle base case

  if( sum == 0) return 1;
  if(vis[sum] == 1) return dp[sum];
  int res = 0;

  for(int j = 1; j <= 6; j++){
    if(sum >= j){
         res += solve(sum - j);
         res %= mod;
    }
  }
  vis[sum] = 1;
  dp[sum] = res;
  return res;

}


int main(){

   // int n;
    cin >> n;

    int ans = solve(n);

    cout << ans << '\n';

return 0;
}









