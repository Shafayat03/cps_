/// Bruteforce code
complexity : O(6^n)
int n;
int solve(int sum){

  /// handle base case

  if( sum == 0) return 1;

  int res = 0;

  for(int j = 1; j <= 6; j++){
    if(sum >= j){
         res += solve(sum - j);
    }
  }
  return res;

}


