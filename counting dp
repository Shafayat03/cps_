/// Bruteforce code

int n;
int solve(int sum){

  /// handle base case

  if( sum == 0) return 1;

  int res = 0;

  for(int j = 1; j <= 6; j++){
    if(sum >= j){
         res += solve(sum - j);
    }
  }
  return res;

}


int main(){

   // int n;
    cin >> n;

    int ans = solve(n);

    cout << ans << '\n';

return 0;
}
